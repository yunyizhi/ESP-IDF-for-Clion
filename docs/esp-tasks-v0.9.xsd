<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://yunyizhi.github.io/ESP-IDF-for-Clion/schema/v0.9"
           xmlns:tns="https://yunyizhi.github.io/ESP-IDF-for-Clion/schema/v0.9"
           elementFormDefault="qualified">

    <xs:complexType name="BaseCommandType" abstract="true">
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    <p>unique name</p>
                    <p>不可重复的名称</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="icon" type="tns:IconType" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <p>Currently supported icon types from IntelliJ platform:</p>
                    <p>目前支持的图标类型：</p>
                    <ul>
                        <li>ij:AllIcons.FileTypes.Config</li>
                        <li>ij:AllIcons.General.Delete</li>
                        <li>ij:AllIcons.Actions.Compile</li>
                        <li>ij:AllIcons.General.Web</li>
                        <li>ij:AllIcons.Actions.Refresh</li>
                    </ul>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="toolTip" type="xs:string" use="optional">
        </xs:attribute>
        <xs:attribute name="env" type="tns:EnvVarsType" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <p>Extended environment variables written inline as an attribute: a variable list where each
                        line contains exactly one <code>key=value</code> variable. Use the child element when the
                        content is multi-line.
                    </p>
                    <p>拓展环境变量，行内属性写法：变量列表，每行只写一个 <code>key=value</code> 变量；多行内容建议使用子标签。
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="profile" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <p>Name(s) of named profiles applied to this task, separated by whitespace. Anonymous profiles are
                        always applied.
                    </p>
                    <p>本任务应用的有名 Profile（可多个，空白分隔）。匿名 Profile 始终生效。</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- 🏁 根元素 -->
    <xs:element name="esp-tasks" type="tns:EspTasksType">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Each task is identified by its unique <code>@name</code> (there is no <code>id</code> attribute
                    in this schema). When exposed through the MCP task tools, a task's identifier is derived as
                    <code>c.</code> + name, where any whitespace character in the name is replaced with
                    <code>-</code> (e.g. name "Build Flash" becomes id "c.Build-Flash").
                </p>
                <p>
                    每个任务以唯一的 <code>@name</code> 作为标识（本 schema 没有 <code>id</code> 属性）。通过 MCP 任务工具暴露时，
                    任务标识推导为 <code>c.</code> + name，其中 name 中的空白字符会被替换为 <code>-</code>
                    （例如 name 为 "Build Flash" 时，id 为 "c.Build-Flash"）。
                </p>
                <p>
                    Optional <code>&lt;profile&gt;</code> variable groups define extended environment variables
                    (<code>&lt;envs&gt;</code>) and replacement macros (<code>&lt;macros&gt;</code>); expand them in a
                    task's <code>value</code>/<code>args</code> with <code>${env:key}</code> / <code>${v:key}</code>.
                    A profile without <code>@name</code> is anonymous and imported globally; a named profile must be
                    referenced by a task's <code>profile</code> attribute. Profiles must appear before task elements.
                </p>
                <p>
                    可选的 <code>&lt;profile&gt;</code> 变量组定义拓展环境变量（<code>&lt;envs&gt;</code>）与替换宏
                    （<code>&lt;macros&gt;</code>）；在任务的 <code>value</code>/<code>args</code> 中分别用
                    <code>${env:key}</code> / <code>${v:key}</code> 展开。不带 <code>@name</code> 的 profile 为匿名，
                    全局导入；带名称的 profile 需由任务的 <code>profile</code> 属性引用。profile 需写在任务元素之前。
                </p>
            </xs:documentation>
        </xs:annotation>
        <!-- ✅ 约束：任务名（command/console-command/exec）之间必须唯一 -->
        <xs:unique name="UniqueCommandName">
            <xs:selector xpath="tns:command|tns:console-command|tns:exec"/>
            <xs:field xpath="@name"/>
        </xs:unique>
        <!-- ✅ 约束：命名 profile 之间必须唯一（与任务名互不影响） -->
        <xs:unique name="UniqueProfileName">
            <xs:selector xpath="tns:profile"/>
            <xs:field xpath="@name"/>
        </xs:unique>
    </xs:element>

    <xs:complexType name="EspTasksType">
        <xs:sequence>
            <!-- 变量组 Profile：匿名时全局导入，命名时由任务的 profile 属性引用 -->
            <xs:element name="profile" type="tns:ProfileType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        <p>A variable profile. Without <code>@name</code> it is anonymous and imported globally for
                            every task; with a <code>@name</code> it applies only to tasks that reference it via their
                            <code>profile</code> attribute.
                        </p>
                        <p>变量组 Profile：不带 <code>@name</code> 时为匿名，对所有任务全局导入；
                            带 <code>@name</code> 时仅对通过 <code>profile</code> 属性引用它的任务生效。
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:choice maxOccurs="unbounded" minOccurs="0">
                <xs:element name="command" type="tns:CommandType">
                    <xs:annotation>
                        <xs:documentation>
                            <p>
                                <code>idf.py</code>
                                command tasks with advanced features like serial port preemption and console filters
                                (e.g., file links can jump to specific IDE lines).
                            </p>
                            <p><code>idf.py</code>命令任务，比起终端任务可以实现串口占用抢占和控制台过滤器(文件链接可以跳转ide的具体行等)
                            </p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="console-command" type="tns:ConsoleCommandType">
                    <xs:annotation>
                        <xs:documentation>
                            <p>
                                <code>idf.py</code>
                                command terminal task with full TTY capabilities compared to regular terminal tasks.
                            </p>
                            <p><code>idf.py</code>命令终端任务，比起普通任务终端具备完整TTY能力
                            </p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="exec" type="tns:ExecType">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Local task that can inherit current environment variables to execute commands.</p>
                            <p>本地任务，也可继承当前环境变量，执行任务</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <!-- 🎨 图标类型 -->
    <xs:simpleType name="IconType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ij:AllIcons.FileTypes.Config"/>
            <xs:enumeration value="ij:AllIcons.General.Delete"/>
            <xs:enumeration value="ij:AllIcons.Actions.Compile"/>
            <xs:enumeration value="ij:AllIcons.General.Web"/>
            <xs:enumeration value="ij:AllIcons.Actions.Refresh"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- 🔧 拓展环境变量类型：变量列表，每行仅一个 key=value，行内属性、子标签与变量组共用 -->
    <xs:simpleType name="EnvVarsType">
        <xs:annotation>
            <xs:documentation>
                <p>Extended environment variable list. The list is written one variable per line, so every line must
                    contain exactly one <code>key=value</code> pair (blank leading/trailing lines are ignored).
                    A variable defined here can be expanded in task <code>value</code>/<code>args</code> with
                    <code>${env:key}</code>.
                </p>
                <p>Values may append to an existing variable via <code>${env:key}</code>, e.g.
                    <code>PATH=/opt/x:${env:PATH}</code>. Inside a value only <code>${env:key}</code> is expanded;
                    macros like <code>${v:key}</code> are NOT processed here and are kept literally.
                </p>
                <p>拓展环境变量列表。列表按行书写，每行只能有一个变量，写作 <code>key=value</code>（首尾的空行会被忽略）。
                    在任务的 <code>value</code>/<code>args</code> 中可用 <code>${env:key}</code> 展开。
                </p>
                <p>值里可用 <code>${env:key}</code> 追加现有变量，如 <code>PATH=/opt/x:${env:PATH}</code>。
                    值内只解析 <code>${env:key}</code>；<code>${v:key}</code> 等宏在此不处理、原样保留。
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\s*[^=\r\n]+=[^\r\n]*(\r?\n\s*[^=\r\n]+=[^\r\n]*)*\s*"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- 🔧 替换宏类型：变量列表，每行仅一个 key=value，通过 ${v:key} 在任务文本中展开 -->
    <xs:simpleType name="MacrosType">
        <xs:annotation>
            <xs:documentation>
                <p>Replacement macro list. Same syntax as extended environment variables: one <code>key=value</code>
                    per line. A macro is expanded in task <code>value</code>/<code>args</code> with
                    <code>${v:key}</code>.
                </p>
                <p>替换宏列表。写法与拓展环境变量一致：每行一个 <code>key=value</code>。在任务的
                    <code>value</code>/<code>args</code> 中用 <code>${v:key}</code> 展开。
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\s*[^=\r\n]+=[^\r\n]*(\r?\n\s*[^=\r\n]+=[^\r\n]*)*\s*"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- 🧩 变量组 Profile：包含拓展环境变量（envs）与替换宏（macros），匿名时全局导入 -->
    <xs:complexType name="ProfileType">
        <xs:sequence>
            <xs:element name="envs" type="tns:EnvVarsType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <p>Extended environment variables: write the variable list directly, one <code>key=value</code>
                            per line. Injected into the process environment and expandable with <code>${env:key}</code>.
                        </p>
                        <p>拓展环境变量：直接写变量列表，每行一个 <code>key=value</code>。注入进程环境，
                            并可用 <code>${env:key}</code> 展开。
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="macros" type="tns:MacrosType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <p>Replacement macros: write the macro list directly, one <code>key=value</code> per line,
                            expandable with <code>${v:key}</code>.
                        </p>
                        <p>替换宏：直接写宏列表，每行一个 <code>key=value</code>，可用 <code>${v:key}</code> 展开。
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <p>Profile name. Omit to make it anonymous, which is imported globally for every task.</p>
                    <p>Profile 名称。省略即为匿名，对所有任务全局导入。</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- 🧩 command 继承 BaseCommandType -->
    <xs:complexType name="CommandType">
        <xs:complexContent>
            <xs:extension base="tns:BaseCommandType">
                <xs:sequence>
                    <xs:element name="env" type="tns:EnvVarsType" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Extended environment variables written as a child element: a variable list where
                                    each line contains exactly one <code>key=value</code> variable.
                                </p>
                                <p>拓展环境变量，子标签写法：变量列表，每行只写一个 <code>key=value</code> 变量。
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="value" type="xs:string" use="required">
                    <xs:annotation>
                        <xs:documentation>
                            <p>
                                <p>Arguments for
                                    <code>idf.py</code>
                                </p>
                            </p>
                            <p><code>idf.py</code>的参数
                            </p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="console-filter" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>When this option is enabled, the console view output will be processed: stderr will be
                                highlighted in red, and the printed file lines will become clickable links for
                                navigation.
                            </p>
                            <p>
                                使能此项后，会对控制台视图输出进行处理，stderr会被以红色标记，打印的具体文件行也会变成链接可以进行跳转
                            </p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="request-port" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Requests serial port. Automatically terminates any Monitor task currently using the
                                requested port.
                            </p>
                            <p>请求串口。会关闭当前占用该串口的Monitor任务</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="use-monitor" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Registers as a Monitor task. Any active task on the same serial port will be interrupted
                                by a port-requesting task. This attribute implicitly enables 'request-port' capability.
                            </p>
                            <p>
                                注册为Monitor任务，同一串口的当前任务会被request-port任务中断，本属性也包含request-port能力
                            </p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>


    <!-- 🧩 console-command 继承 BaseCommandType -->
    <xs:complexType name="ConsoleCommandType">
        <xs:complexContent>
            <xs:extension base="tns:BaseCommandType">
                <xs:sequence>
                    <xs:element name="env" type="tns:EnvVarsType" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Extended environment variables written as a child element: a variable list where
                                    each line contains exactly one <code>key=value</code> variable.
                                </p>
                                <p>拓展环境变量，子标签写法：变量列表，每行只写一个 <code>key=value</code> 变量。
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="value" type="xs:string" use="required">
                    <xs:annotation>
                        <xs:documentation>
                            <p>
                                <p>Arguments for
                                    <code>idf.py</code>
                                </p>
                            </p>
                            <p><code>idf.py</code>的参数
                            </p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- 🧩 exec 继承 BaseCommandType -->
    <xs:complexType name="ExecType">
        <xs:complexContent>
            <xs:extension base="tns:BaseCommandType">
                <xs:sequence>
                    <!-- 可选的 args 子元素 -->
                    <xs:element name="args" type="xs:string" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Command-line arguments for the executable. Can be specified as a child element.</p>
                                <p>命令行参数，可作为子元素提供</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="env" type="tns:EnvVarsType" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Extended environment variables written as a child element: a variable list where
                                    each line contains exactly one <code>key=value</code> variable.
                                </p>
                                <p>拓展环境变量，子标签写法：变量列表，每行只写一个 <code>key=value</code> 变量。
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="path" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Executable file path: It can be an absolute path, an executable found in directories
                                listed in the PATH environment variable (use args if a path relative to this project is
                                needed). If left empty, the system default shell (cmd, bash, or zsh) will be used to
                                execute the command.
                            </p>
                            <p>
                                可执行文件路径:可以是全路径,PATH变量中的路径下的可执行文件(需要使用相对本项目的路径可使用args)。为空时默认使用cmd/bash/zsh执行
                            </p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="args" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Command-line arguments for the executable.</p>
                            <p>命令参数</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="in-terminal" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Determines whether to execute in a terminal emulator.</p>
                            <p>是否在终端中执行</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="idf-env" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Inherits the current project's ESP-IDF environment variables.</p>
                            <p>是否继承当前项目的esp-idf的环境变量</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="encoding" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>
                            <p>The encoding used by the console.</p>
                            <p>控制台编码(不传时将从操作系统读取)</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

</xs:schema>