<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://yunyizhi.github.io/ESP-IDF-for-Clion/schema/v0.7"
           xmlns:tns="https://yunyizhi.github.io/ESP-IDF-for-Clion/schema/v0.7"
           elementFormDefault="qualified">

    <xs:complexType name="BaseCommandType" abstract="true">
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    <p>unique name</p>
                    <p>不可重复的名称</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="icon" type="tns:IconType" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <p>Currently supported icon types from IntelliJ platform:</p>
                    <p>目前支持的图标类型：</p>
                    <ul>
                        <li>ij:AllIcons.FileTypes.Config</li>
                        <li>ij:AllIcons.General.Delete</li>
                        <li>ij:AllIcons.Actions.Compile</li>
                        <li>ij:AllIcons.General.Web</li>
                        <li>ij:AllIcons.Actions.Refresh</li>
                    </ul>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="toolTip" type="xs:string" use="optional">
        </xs:attribute>
    </xs:complexType>

    <!-- 🏁 根元素 -->
    <xs:element name="esp-tasks" type="tns:EspTasksType">
        <!-- ✅ 全局约束：所有子元素的 @name 必须唯一 -->
        <xs:unique name="UniqueCommandName">
            <xs:selector xpath="*"/>
            <xs:field xpath="@name"/>
        </xs:unique>
    </xs:element>

    <xs:complexType name="EspTasksType">
        <xs:sequence>
            <xs:choice maxOccurs="unbounded" minOccurs="0">
                <xs:element name="command" type="tns:CommandType">
                    <xs:annotation>
                        <xs:documentation>
                            <p><code>idf.py</code> command tasks with advanced features like serial port preemption and console filters (e.g., file links can jump to specific IDE lines).</p>
                            <p><code>idf.py</code>命令任务，比起终端任务可以实现串口占用抢占和控制台过滤器(文件链接可以跳转ide的具体行等)</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="console-command" type="tns:ConsoleCommandType">
                    <xs:annotation>
                        <xs:documentation>
                            <p><code>idf.py</code> command terminal task with full TTY capabilities compared to regular terminal tasks.</p>
                            <p><code>idf.py</code>命令终端任务，比起普通任务终端具备完整TTY能力</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="exec" type="tns:ExecType">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Local task that can inherit current environment variables to execute commands.</p>
                            <p>本地任务，也可继承当前环境变量，执行任务</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <!-- 🎨 图标类型 -->
    <xs:simpleType name="IconType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ij:AllIcons.FileTypes.Config"/>
            <xs:enumeration value="ij:AllIcons.General.Delete"/>
            <xs:enumeration value="ij:AllIcons.Actions.Compile"/>
            <xs:enumeration value="ij:AllIcons.General.Web"/>
            <xs:enumeration value="ij:AllIcons.Actions.Refresh"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- 🧩 command 继承 BaseCommandType -->
    <xs:complexType name="CommandType">
        <xs:complexContent>
            <xs:extension base="tns:BaseCommandType">
                <xs:attribute name="value" type="xs:string" use="required">
                    <xs:annotation>
                        <xs:documentation>
                            <p><p>Arguments for <code>idf.py</code></p></p>
                            <p><code>idf.py</code>的参数</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="console-filter" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>When this option is enabled, the console view output will be processed: stderr will be highlighted in red, and the printed file lines will become clickable links for navigation.</p>
                            <p>使能此项后，会对控制台视图输出进行处理，stderr会被以红色标记，打印的具体文件行也会变成链接可以进行跳转</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="request-port" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Requests serial port. Automatically terminates any Monitor task currently using the requested port.</p>
                            <p>请求串口。会关闭当前占用该串口的Monitor任务</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="use-monitor" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Registers as a Monitor task. Any active task on the same serial port will be interrupted by a port-requesting task. This attribute implicitly enables 'request-port' capability.</p>
                            <p>注册为Monitor任务，同一串口的当前任务会被request-port任务中断，本属性也包含request-port能力</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>


    <!-- 🧩 console-command 继承 BaseCommandType -->
    <xs:complexType name="ConsoleCommandType">
        <xs:complexContent>
            <xs:extension base="tns:BaseCommandType">
                <xs:attribute name="value" type="xs:string" use="required">
                    <xs:annotation>
                        <xs:documentation>
                            <p><p>Arguments for <code>idf.py</code></p></p>
                            <p><code>idf.py</code>的参数</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- 🧩 exec 继承 BaseCommandType -->
    <xs:complexType name="ExecType">
        <xs:complexContent>
            <xs:extension base="tns:BaseCommandType">
                <xs:sequence>
                    <!-- 可选的 args 子元素 -->
                    <xs:element name="args" type="xs:string" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Command-line arguments for the executable. Can be specified as a child element.</p>
                                <p>命令行参数，可作为子元素提供</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:element>
                </xs:sequence>
                <xs:attribute name="path" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Executable file path: It can be an absolute path, an executable found in directories
                                listed in the PATH environment variable, or a path relative to the current project.
                                If left empty, the system default shell (cmd, bash, or zsh) will be used to
                                execute the command.</p>
                            <p>可执行文件路径:可以是全路径,PATH变量中的路径下的可执行文件,也可以是基于当前项目的相对路径。为空时默认使用cmd/bash/zsh执行</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="args" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Command-line arguments for the executable.</p>
                            <p>命令参数</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="in-terminal" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Determines whether to execute in a terminal emulator.</p>
                            <p>是否在终端中执行</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="idf-env" type="xs:boolean" use="optional" default="false">
                    <xs:annotation>
                        <xs:documentation>
                            <p>Inherits the current project's ESP-IDF environment variables.</p>
                            <p>是否继承当前项目的esp-idf的环境变量</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="encoding" type="xs:string" use="optional">
                    <xs:annotation>
                        <xs:documentation>
                            <p>The encoding used by the console.</p>
                            <p>控制台编码(不传时将从操作系统读取)</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

</xs:schema>