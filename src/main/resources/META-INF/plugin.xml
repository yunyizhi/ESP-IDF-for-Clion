<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>org.btik.idf-for-clion</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>ESP-IDF</name>
    <depends>com.intellij.modules.clion</depends>
    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="lustreofjade@qq.com" url="">云逸之</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
Enables <a href="https://docs.espressif.com/projects/esp-idf/">ESP-IDF(Espressif IoT Development Framework)</a> support.
<ul>
    <li>Supports creating ESP-IDF projects with automatic configuration and initialization.</li>
    <li>Simplifies the ESP-IDF command set by encapsulating certain commands within a GUI.</li>
</ul>
支持 <a href="https://docs.espressif.com/projects/esp-idf/zh_CN/latest/esp32/index.html">ESP-IDF(Espressif IoT Development Framework)</a> .
<ul>
    <li>支持创建ESP-IDF项目，并自动配置环境并初始化。</li>
    <li>简单封装了部分idf命令为界面。</li>
</ul>
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.clion.embedded</depends>
    <depends>com.jetbrains.sh</depends>
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <directoryProjectGenerator implementation="org.btik.espidf.project.generator.toolchain.IdfProjectGenerator"
                                   id="org.btiik.espidf" order="after jetbrains.cidr.stm32cubemx"/>
        <directoryProjectGenerator implementation="org.btik.espidf.project.generator.idfenv.IdfProjectGenerator"
                                   id="org.btiik.espidf.by.idf.env" order="after org.btiik.espidf"/>
        <notificationGroup id="org.btiik.espidf" displayType="BALLOON" bundle="messages.org_btik_espidf"
                           key="notification.group"/>
        <postStartupActivity implementation="org.btik.espidf.state.EspIdfProjectActivity"/>
        <toolWindow id="ESP-IDF" icon="/org-btik-esp-idf/image/idf13_13.svg" anchor="right"
                    factoryClass="org.btik.espidf.toolwindow.EspIdfToolWindowFactory"/>
        <applicationService serviceInterface="org.btik.espidf.service.IdfSysConfService"
                            serviceImplementation="org.btik.espidf.conf.IdfSysConfManager"/>
        <projectService serviceImplementation="org.btik.espidf.environment.IdfEnvironmentServiceImpl"
                        serviceInterface="org.btik.espidf.service.IdfEnvironmentService"/>
        <projectService serviceImplementation="org.btik.espidf.state.IdfProjectConfigComponent"
                        serviceInterface="org.btik.espidf.service.IdfProjectConfigService"/>
        <executionTargetProvider implementation="org.btik.espidf.run.config.EspIdfExecutionTargetProvider" />
        <configurationType order="last" id="esp_idf"
                           implementation="org.btik.espidf.run.config.EspIdfRunConfigType"/>
        <statusBarWidgetFactory
                implementation="org.btik.espidf.state.EspIdfTargetBarBarWidgetFactory" id="esp_idf_target"/>
        <editorFloatingToolbarProvider id="org_btik_espidf.env"
                                       implementation="org.btik.espidf.state.env.EspIdfEnvFloatingToolbarProvider"
        />
        <postStartupActivity implementation="org.btik.espidf.state.EspIdfProjectManagerListener"/>
        <runLineMarkerContributor language="XML" implementationClass="org.btik.espidf.toolwindow.tasks.line.marker.EspCustomRunLineMarkerContributor"/>
    </extensions>
    <projectListeners>
        <listener topic="com.jetbrains.cidr.cpp.cmake.workspace.CMakeWorkspaceListener"
                  class="org.btik.espidf.state.EspIdfCMakeStatusListener"/>
        <listener class="org.btik.espidf.state.CMakeStateListener"
                  topic="com.jetbrains.cidr.cpp.cmake.CMakeSettingsListener"/>
    </projectListeners>
    <actions>
        <group id="reload_idf_env">

            <action id="reload_idf_env.do" class="org.btik.espidf.state.env.LoadEspIdfEnvsAction"/>
            <action id="reload_idf_env.cancel" class="org.btik.espidf.state.env.LoadEspIdfEnvsCancelAction"/>
        </group>
    </actions>
</idea-plugin>