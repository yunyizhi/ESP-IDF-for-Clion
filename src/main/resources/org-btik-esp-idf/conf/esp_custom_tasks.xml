<?xml version="1.0" encoding="UTF-8" ?>
<esp-tasks xmlns="https://yunyizhi.github.io/ESP-IDF-for-Clion/schema"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="https://yunyizhi.github.io/ESP-IDF-for-Clion/schema https://yunyizhi.github.io/ESP-IDF-for-Clion/esp-tasks.xsd">

    <command name="List Targets" value="--list-targets" icon="ij:AllIcons.Actions.Compile"/>
    <console-command name="Size" value="size" />
    <exec name="echo IDF_PATH" args="echo $IDF_PATH " idf-env="true" />
    <exec name="test py" path="python3" in-terminal="true">
        <args><![CDATA[
print(1)
exit()
        ]]></args>
    </exec>
    <exec name="bash echo 1" path="/bin/bash"
          args="-c &quot; echo 111 &quot;" />
    <exec name="test py 1" path="python3 -V" in-terminal="true" />
    <exec name="echo in terminal" args="echo 1 " in-terminal="true" icon="ij:AllIcons.Actions.Compile" />
</esp-tasks>