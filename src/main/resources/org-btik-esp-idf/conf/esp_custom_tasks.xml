<?xml version="1.0" encoding="UTF-8" ?>
<esp-tasks xmlns="https://yunyizhi.github.io/ESP-IDF-for-Clion/schema/v0.7"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="https://yunyizhi.github.io/ESP-IDF-for-Clion/schema/v0.7 https://yunyizhi.github.io/ESP-IDF-for-Clion/esp-tasks-v0.7.xsd">

    <command name="List Targets" value="--preview --list-targets"/>

    <command name="Build App" value="app" icon="ij:AllIcons.Actions.Compile" console-filter="true" />

    <command name="Flash-App And Monitor" value="app-flash monitor"
             console-filter="true" use-monitor="true"/>

    <console-command name="Size" value="size"/>

    <exec name="Default-Shell Test" args="echo hello world"/>

    <exec name="cmd echo test" path="cmd" args="/c echo hello world"/>

    <exec name="bash echo test" path="/bin/bash" args="-c echo hello world"/>

    <exec name="Test IDF_ENV 1"  path="cmd" args="echo 1" idf-env="true" encoding="utf-8"/>

    <exec name="Test IDF_ENV" path="python" args="-m esptool" idf-env="true" encoding="utf-8"/>

    <exec name="Terminal Base Test" in-terminal="true">
        <args><![CDATA[
echo $env:path
dir
        ]]></args>
    </exec>


</esp-tasks>