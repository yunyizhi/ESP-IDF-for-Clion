<?xml version="1.0" encoding="UTF-8" ?>
<taskTree>
    <tree name="Tasks" icon="/org-btik-esp-idf/image/idf13_13.svg">
        <folder name="General">
            <command name="Build" value="build" icon="ij:AllIcons.Actions.Compile" toolTip="${idf.tip.build}" console-filter="true"/>
            <command name="Full Clean and Reconfigure" value="fullclean reconfigure" toolTip="${idf.tip.reconfigure}" icon="ij:AllIcons.Actions.Refresh" />
            <command name="Flash" value="flash" console-filter="true" request-port="true" />
            <!--        use-monitor 为true则必须请求端口，则requestPort 为true 优先级高于 request-port -->
            <command name="Monitor" value="monitor" console-filter="true" toolTip="${idf.monitor.tip}" use-monitor="true" />
            <command name="Flash and Monitor" value="flash monitor" console-filter="true" use-monitor="true"/>
            <console-command name="Monitor Terminal" value="monitor" toolTip="${idf.monitor.terminal.tip}" />
            <command name="APP Flash" value="app-flash" console-filter="true" toolTip="${idf.app.flash.tip.build}" request-port="true" />
            <command name="Clean" value="clean" icon="ij:AllIcons.General.Delete" toolTip="${idf.tip.clean}"/>
            <command name="Full Clean" value="fullclean" icon="ij:AllIcons.General.Delete" toolTip="${idf.tip.full.clean}" />
            <console-command name="Menu Config" value="menuconfig" />
            <console-command name="IDF Console" value="" />
            <action name="IDF Export Console" id="idf.export.console" />
        </folder>
        <folder name="Miscellaneous">
            <raw-command name="Export Environments"
                         win-value="SET"
                         unix-value="env" />
            <action name="Rebuild All EnvVars Caches" toolTip="${esp.idf.rebuild.envs}" id="idf.rebuild.all.env.cache" icon="ij:AllIcons.Actions.Refresh" />
            <command name="Erase" value="erase-flash" request-port="true" />
            <command name="Size" value="size"/>
            <action name="ESP Component Registry" id="open.component.registry" icon="ij:AllIcons.General.Web" />
        </folder>
        <folder name="Help">
            <command name="ESP-IDF Docs" value="docs" icon="ij:AllIcons.General.Web"/>
        </folder>
        <folder name="${esp.idf.task.tree.custom.tasks}" id="custom.tasks.folder">
            <action name="${esp.idf.task.custom.tasks.load}" id="idf.custom.tasks.load" icon="ij:AllIcons.Actions.Refresh"
                    toolTip="${esp.idf.task.custom.tasks.load.from.xml}"/>
        </folder>
    </tree>
</taskTree>